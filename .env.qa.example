# Configuración de Entorno QA - pedidos-qa.distribuidoratridente.cl
# Utilizado por scripts administrativos y despliegues en QA

POSTGREST_URL=http://localhost:3000
POSTGREST_SCHEMA=bdtridente-qa
POSTGREST_TOKEN=

# Base de datos PostgreSQL en QA
DATABASE_HOST=pedidos-qa.distribuidoratridente.cl
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=bdtridente-qa
DATABASE_USER=tridente_qa
DATABASE_PASSWORD=replace-with-qa-password

# Claves de Google Gemini para procesamiento de imágenes y Agente IA
# Puedes ingresar una o múltiples claves separadas por coma para rotación automática
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash-high
