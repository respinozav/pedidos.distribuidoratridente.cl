# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO: QA / STAGING (Rama qa)
# Distribuidora Tridente - pedidos-qa.distribuidoratridente.cl
# ==============================================================================

# Base de Datos PostgreSQL en QA
DATABASE_HOST=pedidos-qa.distribuidoratridente.cl
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=bdtridente-qa
DATABASE_USER=tridente_qa
DATABASE_PASSWORD=replace-with-qa-password

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=replace-with-strong-qa-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Red y CORS
CORS_ORIGINS=https://pedidos-qa.distribuidoratridente.cl,http://pedidos-qa.distribuidoratridente.cl,http://localhost:5173

# Integración Defontana API (ERP - Entorno QA / Pruebas)
DEFONTANA_API_BASE_URL=https://replapi.defontana.com
DEFONTANA_CLIENT_ID=20250217200717633001
DEFONTANA_COMPANY_ID=20250217200717633001
DEFONTANA_API_USER=INTEGRACION
DEFONTANA_API_PASSWORD=replace-with-qa-defontana-password

# Agente Tridente IA (Google Gemini)
GEMINI_API_KEY=replace-with-qa-gemini-key
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgREST
POSTGREST_URL=http://localhost:3000
POSTGREST_SCHEMA=bdtridente-qa
POSTGREST_TOKEN=

# Notificaciones por Correo (SMTP - Entorno QA)
SMTP_HOST=s550.v2nets.com
SMTP_PORT=465
SMTP_USERNAME=pedidos@correotridente.cl
SMTP_PASSWORD=replace-with-email-password
SMTP_FROM_EMAIL=pedidos@correotridente.cl
SMTP_FROM_NAME=Distribuidora Tridente (QA)

# Notificaciones por WhatsApp (Evolution API - Entorno QA)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_GLOBAL_KEY=tridente_global_secret_123
WHATSAPP_INSTANCE_NAME=tridente_ws_qa
