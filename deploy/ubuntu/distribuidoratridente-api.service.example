[Unit]
Description=Distribuidora Tridente API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/distribuidoratridente.cl/backend
EnvironmentFile=/var/www/distribuidoratridente.cl/.env
ExecStart=/var/www/distribuidoratridente.cl/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target