server {
    listen 80;
    listen [::]:80;
    server_name pedidos.distribuidoratridente.cl;

    root /var/www/distribuidoratridente.cl/frontend/dist;
    index index.html;

    location = /CatalogoPublico {
        proxy_pass http://127.0.0.1:8001/api/catalogo-publico;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}